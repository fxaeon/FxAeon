{
  "name": "FxAeon",
  "private": true,
  "workspaces": [
    "apps/landing",
    "apps/mini-app"
  ],
  "scripts": {
    "build": "pnpm --dir apps/mini-app build",
    "build:landing": "node apps/landing/build.mjs",
    "preview:landing": "node apps/landing/serve.mjs",
    "test:landing": "node --test apps/landing/test/static.test.mjs",
    "test:landing:browser": "node scripts/verify_landing_browser.mjs",
    "dev": "pnpm --dir apps/mini-app dev",
    "lint": "eslint apps/mini-app/src apps/mini-app/test",
    "lint:fix": "eslint apps/mini-app/src --fix",
    "test": "pnpm --dir apps/mini-app test",
    "test:chaos": "pnpm --dir apps/mini-app test:chaos",
    "test:anvil": "node scripts/run_anvil_tests.mjs --suite protocol",
    "test:anvil:contract": "node --test scripts/run_anvil_tests.contract.test.mjs",
    "test:telegram:contract": "node --test scripts/telegram_bot_sync.contract.test.mjs",
    "test:live-public-config:contract": "node --test scripts/verify_live_public_config.contract.test.mjs",
    "test:architecture:contract": "node --test scripts/verify_architecture.contract.test.mjs",
    "test:anvil:earn": "node scripts/run_anvil_tests.mjs --suite earn",
    "test:anvil:stress": "node scripts/run_anvil_tests.mjs --suite stress",
    "test:anvil:all": "node scripts/run_anvil_tests.mjs --suite all",
    "test:anvil:browser": "node scripts/run_anvil_tests.mjs --suite browser",
    "test:deploy-workflow": "node --test scripts/deploy_workflow.contract.test.mjs scripts/release_revision.test.mjs scripts/check_live_gas_oracle.contract.test.mjs scripts/verify_built_rpc_config.test.mjs",
    "test:stress": "pnpm test:chaos && pnpm test:anvil:stress",
    "test:e2e": "pnpm --dir apps/mini-app test:e2e",
    "test:e2e:borrow-harness": "pnpm --dir apps/mini-app test:e2e:borrow-harness",
    "test:e2e:move-harness": "pnpm --dir apps/mini-app test:e2e:move-harness",
    "test:e2e:positions-harness": "pnpm --dir apps/mini-app test:e2e:positions-harness",
    "test:e2e:privy-send-harness": "pnpm --dir apps/mini-app test:e2e:privy-send-harness",
    "test:e2e:trade-harness": "pnpm --dir apps/mini-app test:e2e:trade-harness",
    "test:e2e:overlay": "pnpm --dir apps/mini-app test:e2e:overlay",
    "test:e2e:state-lab": "pnpm --dir apps/mini-app test:e2e:state-lab",
    "typecheck": "pnpm --dir apps/mini-app typecheck && tsc -p apps/mini-app/e2e/fork/tsconfig.json && pnpm typecheck:e2e",
    "typecheck:e2e": "node --test scripts/e2e_typecheck.contract.test.mjs && pnpm --dir apps/mini-app typecheck:e2e",
    "verify:production-env": "node scripts/validate_production_env.mjs",
    "verify:scope": "node scripts/verify_fx_scope.mjs",
    "verify:architecture": "node scripts/verify_architecture.mjs",
    "check:bundle": "node scripts/check_bundle_size.mjs",
    "docs:screenshots": "node scripts/capture_docs_screenshots.mjs",
    "docs:screenshots:positions": "node scripts/capture_position_screenshots.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "pnpm audit --prod --audit-level=high",
    "audit:all": "node scripts/audit_dependencies.mjs"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "11.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "15.5.24",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "wrangler": "4.144.0"
  },
  "packageManager": "pnpm@11.19.0",
  "version": "2.0.0"
}
