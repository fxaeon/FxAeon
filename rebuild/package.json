{
  "name": "@fxaeon/rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": "22.x", "pnpm": "11.19.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:fixture": "vite build --mode fixture --outDir dist-fixture",
    "preview": "node scripts/serve.mjs --dir dist --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-unit.mjs",
    "test:browser": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@aladdindao/fx-sdk": "1.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
